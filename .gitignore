# OS
.DS_Store
Thumbs.db

# IDE
.vs/
.idea/
*.suo
*.user
*.userprefs
*.DotSettings.user

# Build artifacts
[Oo]bj/
[Bb]uild/
[Bb]uilds/
*.log

# VST3 SDK (developer checkout via native~/windows-vst-host/Fetch-Vst3Sdk.*)
# Not a git submodule — keeps UPM Git URL installs off the deep Steinberg tree.
native~/windows-vst-host/vst3sdk/

# Native build output (committed DLLs/bundles go in Plugins/)
# Folder is native~ so Unity AssetDatabase ignores it on Git/file: installs.
native~/**/build/
native~/**/build-x64/
native~/**/build-arm64/
native~/**/out/
# Legacy path (pre-rename) — keep ignoring if a stray folder reappears
native/**/build/
native/**/build-x64/
native/**/build-arm64/
native/**/out/
*.pdb

# Never commit Unity .meta under native sources (folder should be native~)
native/**/*.meta
native~/**/*.meta
native.meta

# Unity auto-generated
*.csproj
*.sln
*.slnx
*.unityproj
docs/dev
docs/dev.meta
docs.meta
